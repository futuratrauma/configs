{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/YOURUSER/.config/opencode/hooks/no-config-comments.mjs"
          }
        ]
      }
    ]
  }
}
